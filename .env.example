# npm run setup 으로 로컬 CEO 비밀번호와 세션 키를 생성합니다.
CEO_PASSWORD_HASH=
SESSION_SECRET=
OPENAI_API_KEY=
# 계정에서 사용 가능한 모델을 직접 지정합니다. 미설정 시 실제 실행 차단.
OPENAI_MODEL=
# 로컬에서는 미설정 가능. 외부 서버에서는 실제 HTTPS origin을 설정합니다.
APP_ORIGIN=
# 검색 호출 USD 단가를 공식 가격표에서 확인해 입력합니다. 미설정 시 LIVE 차단.
WEB_SEARCH_USD_PER_CALL=0
SEARCH_TOKEN_RESERVE=128000
# 모델을 여러 개 쓰는 경우 모델별 USD/1M token 단가: {"model-id":{"input":0.0,"output":0.0}}
MODEL_PRICING_JSON={}
AGENT_MODE=live
AI_UNIVERSE_DB=./data/company.sqlite
# 추정 단가(USD / 1M tokens)와 환율을 확인한 뒤 입력하세요. 0이면 유료 실행 차단.
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
USD_KRW=0
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
FIGMA_TOKEN=
