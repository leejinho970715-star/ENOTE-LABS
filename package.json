{
  "name": "ai-universe", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "launch": "node scripts/launch.mjs",
    "build": "node scripts/build-server.mjs", "start": "next start --hostname 127.0.0.1",
    "build:pages": "node scripts/build-pages.mjs",
    "worker": "tsx --env-file-if-exists=.env src/workflows/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "demo:report": "node demos/weekly-report/server.mjs",
    "flownote:backup": "node demos/weekly-report/workspace-backup.mjs backup",
    "flownote:restore": "node demos/weekly-report/workspace-backup.mjs restore",
    "test:flownote-http": "node scripts/flownote-http-smoke.mjs",
    "test:live": "tsx --env-file-if-exists=.env scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts", "agents:sync": "tsx scripts/sync-agents.ts"
  },
  "dependencies": { "@openai/agents": "0.21.0", "openai": "7.39.0", "next": "16.4.2", "react": "^19.2.0", "react-dom": "^19.2.0", "zod": "^4.0.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "esbuild": "0.28.2", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
